{
  // The family vote behind yesandeverything.com/thanksgiving-2026/: a thumbs up or down per
  // listing, kept in its own key-value namespace so it never shares storage with the gated
  // pages. The page itself is a static file served by GitHub Pages; only the vote route runs here.
  //
  // No secrets. Voters type a first name and nothing else.
  "name": "family-votes-yesandeverything",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "account_id": "1a36e094b77857eedf7ceb5a99e007d1",

  // A path route on the zone, which takes precedence over the GitHub Pages origin, the same way
  // the gated-docs and coiled-guardian routes do. Only the vote route, so the page stays static.
  "routes": [
    { "pattern": "yesandeverything.com/thanksgiving-2026/api/*", "zone_name": "yesandeverything.com" }
  ],

  "kv_namespaces": [
    { "binding": "VOTES", "id": "aa8ec9aad79340d1ba796ced1ecf3452" }
  ],

  "observability": { "enabled": true }
}
