{
  // The server-side gate for the private page set at yesandeverything.com/coiledguardian.
  //
  // The pages are private, so nothing of theirs may sit in this repository, which is public.
  // Their bodies live in the GATED_DOCS namespace under cg:* keys, written by the owning
  // project's own publish step. They are not here and must not come back here.
  //
  // There is deliberately NO assets binding. An assets binding serves static files before
  // fetch() runs unless run_worker_first is set, and a gate that can be skipped by a path is
  // not a gate.
  //
  // Secrets, set with `wrangler secret put` and never committed:
  //   SESSION_SECRET    HMAC key for the session cookie (random 32 bytes, its own, not shared)
  //   COILED_PASSWORD   the reader phrase for /coiledguardian, the author's own
  //   REVIEWERS         optional, the invited outside readers. A reader signs in with their own
  //                     phrase, the session carries r:<slug>, and their annotations are kept
  //                     under cg:review:<slug>, never mixed with the author's and never
  //                     readable by another reader. Adding or removing one is a single
  //                     `wrangler secret put REVIEWERS` with the new map, no deploy and no
  //                     change to this file. The bound defaults closed:
  //                       {"nell": "phrase"}                          chapters 1 to 30
  //                       {"nell": {"phrase": "...", "through": 45}}  chapters 1 to 45
  //                       {"nell": {"phrase": "...", "all": true}}    everything published
  //                     Anything else, including a misspelled key or the string "true", leaves
  //                     the reader bounded, so a slip in this secret locks down rather than up.
  //   SHARE             optional, the open share link as {"token":"...","through":30}, or a bare
  //                     token string for the default span. The token is the whole credential:
  //                     /coiledguardian/r/<token> signs a reader in with no phrase at all, as
  //                     r:link, bounded the same way and writing to cg:review:link. It is at
  //                     least 24 characters and a shorter one is refused rather than served.
  //                     Deleting this secret drops the link and puts the site back to phrases.
  "name": "coiled-guardian-yesandeverything",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "account_id": "1a36e094b77857eedf7ceb5a99e007d1",

  // A path route on the zone, which takes precedence over the GitHub Pages origin serving the
  // rest of the site, the same way the gated-docs routes already do.
  "routes": [
    { "pattern": "yesandeverything.com/coiledguardian*", "zone_name": "yesandeverything.com" }
  ],

  // The same namespace the design documents use. Keys are prefixed cg: so the two never collide.
  "kv_namespaces": [
    { "binding": "GATED_DOCS", "id": "3dd0b8c004f4473da2305fab795d4abb" }
  ],

  "observability": { "enabled": true }
}
