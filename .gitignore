# OS
.DS_Store
Thumbs.db

# Private invoices and client-facing docs that should not ship to the public site
invoices/

# Python cache (auto-added 2026-05-29 by dead-file cleanup)
__pycache__/
*.pyc

# Audit / scheduled-task report artifacts (regenerated; superseded copies not tracked)
*AUDIT-20*.md
BAR_RAISE-20*.md
CONSTELLATION-20*.md
drift-fixes-20*.md
drift-fix-20*.md
digest-20*.md

# Loop liveness probes + breadcrumbs (transient, regenerated by the work loop)
.loop-*
_probe_*
.write_breadcrumb.py

# Backup copies (never tracked)
*.bak

# Cross-project audit artifacts with a project infix (e.g. CANONICAL_AUDIT-HBH-2026-..)
*AUDIT-*-20*.md
# usage-collector local state
work/data/.usage-state.json
work/data/*.tmp
dashboard/data/.usage-state.json
dashboard/data/*.tmp

CLAUDE_LOG.md

# .work-queue.json and .work-queue-archive.json are deliberately TRACKED - git
# is their only backup. They were listed here while also tracked, which meant a
# single `git rm --cached` would have silently ended the only backup with no
# signal. Only the transient sidecars are ignored.
.work-queue.json.lock
.work-queue.json.corrupt-*
.work-queue-results/
.work-queue-drain-log.json
.work-queue.lock
.work-queue.json.tmp
.work-queue.json.ser-in.tmp
.work-queue.json.ser-out.tmp

# Cloudflare wrangler local cache (dashboard-api worker)
.wrangler/

# loop breadcrumb (written hourly by loop-tick; untracked 2026-07-03)
.next-loop.md
.work-queue.lock.*

# collector / rescan run logs (transient)
scripts/logs/

# loop breadcrumb logs (recreated by the loop tasks)
.queue-breadcrumbs.log
.work-queue-breadcrumb.log

# Secret-shaped filenames. Defensive only: real secrets live in X:\.secrets and
# are never meant to be in this tree at all. This catches the accident where one
# gets written here, since this repo is public and Pages serves the raw tree.
*.pem
*.key
*.p12
*.pfx
*.ppk
.env
.env.*
!.env.example
*secret*.txt
*secret*.json
*token*.txt
*credential*.json
.cloudflare-token
.discord_webhook.txt
id_rsa
id_ed25519
